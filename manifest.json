{
  "manifest_version": 3,
  "name": "小红书笔记采集助手",
  "version": "0.4.0",
  "description": "采集与归档小红书公开笔记，并提供带合规检查的发布、评论填充助手。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.xhscdn.com/*",
    "*://*.xhscdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "小红书笔记采集助手",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
